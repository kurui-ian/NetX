{
  "name": "netx",
  "productName": "NetX",
  "private": true,
  "version": "1.0.1",
  "description": "NetX — Modern Desktop Network Utility & Telemetry Suite",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "start": "electron .",
    "package:exe": "npx.cmd @electron/packager . NetX --platform=win32 --arch=x64 --out=release --overwrite --icon=public/netx-icon.ico --ignore=\"^/(src|src-tauri|release|docs|\\.git)\"",
    "package:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
